#!/usr/bin/env bash
set -euo pipefail

# arkai-convert: Convert HuggingFace models to GGUF format
# Adapted from bragai-convert

QUANT_TYPE=""
OUTFILE=""
SHARE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/arkai"
TOKENIZER_CONFIG=""
TOKENIZER_CONFIG_BACKUP=""

ensure_llama_cpp() {
    LLAMA_CPP_DIR="$SHARE_DIR/llama.cpp"

    if [ -d "$LLAMA_CPP_DIR/.git" ]; then
        echo "Updating llama.cpp..." >&2
        git -C "$LLAMA_CPP_DIR" pull -q
    else
        echo "Cloning llama.cpp (one-time setup)..." >&2
        mkdir -p "$SHARE_DIR"
        git clone --depth 1 -q https://github.com/ggml-org/llama.cpp "$LLAMA_CPP_DIR"
    fi
}

ensure_venv() {
    VENV_DIR="$SHARE_DIR/convert-venv"
    REQ_FILE="$LLAMA_CPP_DIR/requirements/requirements-convert_hf_to_gguf.txt"

    if [ ! -f "$REQ_FILE" ]; then
        REQ_FILE="$LLAMA_CPP_DIR/requirements.txt"
    fi

    if [ ! -d "$VENV_DIR" ]; then
        echo "Creating Python virtualenv..." >&2
        python3 -m venv "$VENV_DIR"
    fi

    source "$VENV_DIR/bin/activate"

    local marker="$VENV_DIR/.deps-installed"
    local req_hash
    req_hash=$(shasum "$REQ_FILE" 2>/dev/null | cut -d' ' -f1)
    if [ ! -f "$marker" ] || [ "$(cat "$marker")" != "$req_hash" ]; then
        echo "Installing Python dependencies..." >&2
        pip install -q -r "$REQ_FILE"
        echo "$req_hash" > "$marker"
    fi
}

resolve_model() {
    local model="$1"
    local provider
    local identifier
    local model_cache="$SHARE_DIR/models/providers"

    # If model is a path, use it directly
    if [[ "$model" == /* ]] || [[ "$model" == ./* ]]; then
        if [ ! -d "$model" ]; then
            echo "Error: directory not found: $model" >&2
            exit 1
        fi
        echo "$model"
        return
    fi

    if ! echo "$model" | grep -q ':'; then
        echo "Error: model must be a provider-qualified reference or local path" >&2
        exit 1
    fi

    provider="${model%%:*}"
    identifier="${model#*:}"
    case "$provider" in
        hf)
            local repository_dir="$model_cache/huggingface/$identifier"
            if [ ! -d "$repository_dir/.git" ]; then
                echo "Model '$model' not found in Arkai model cache" >&2
                exit 1
            fi
            echo "$repository_dir"
            ;;
        ollama)
            local name="${identifier%:*}"
            local tag="${identifier##*:}"
            if [ "$name" = "$identifier" ]; then
                tag="latest"
            fi
            local model_path="$model_cache/ollama/$name/$tag/model.gguf"
            if [ ! -f "$model_path" ]; then
                echo "Model '$model' not found in Arkai model cache" >&2
                exit 1
            fi
            echo "$model_path"
            ;;
        *)
            echo "Error: unsupported model provider '$provider'" >&2
            exit 1
            ;;
    esac
}

restore_tokenizer_config() {
    if [ -n "$TOKENIZER_CONFIG_BACKUP" ] && [ -f "$TOKENIZER_CONFIG_BACKUP" ]; then
        cp "$TOKENIZER_CONFIG_BACKUP" "$TOKENIZER_CONFIG"
        rm -f "$TOKENIZER_CONFIG_BACKUP"
    fi
}

normalize_tokenizer_config() {
    local model_dir="$1"
    TOKENIZER_CONFIG="$model_dir/tokenizer_config.json"
    if [ ! -f "$TOKENIZER_CONFIG" ]; then
        return
    fi

    TOKENIZER_CONFIG_BACKUP=$(mktemp)
    cp "$TOKENIZER_CONFIG" "$TOKENIZER_CONFIG_BACKUP"
    trap restore_tokenizer_config EXIT

    "$VENV_DIR/bin/python3" - "$TOKENIZER_CONFIG" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path) as config_file:
    config = json.load(config_file)

extra_tokens = config.get("extra_special_tokens")
if isinstance(extra_tokens, list):
    config["extra_special_tokens"] = {
        f"extra_special_token_{index}": token
        for index, token in enumerate(extra_tokens)
    }
    with open(path, "w") as config_file:
        json.dump(config, config_file, indent=2)
        config_file.write("\n")
PY
}

usage() {
    cat <<'HELP'
arkai-convert -- Convert HuggingFace models to GGUF format

Usage: arkai-convert [options] MODEL

MODEL can be:
  - A provider-qualified model ID (e.g. hf:apple/DiffuCoder-7B-Base)
  - A local directory containing the model weights

Output defaults to ~/.local/share/arkai/models/MODEL_NAME-QUANTIZATION.gguf.

Options:
  -o FILE    Output file path
  -q TYPE    Quantization type (default: Q6_K; e.g. Q4_K_M, Q5_K_M, Q8_0)
  -h         Show this help

Examples:
  arkai-convert apple/DiffuCoder-7B-Base
  arkai-convert DiffuCoder-7B-Base -q Q4_K_M
  arkai-convert apple/DiffuCoder-7B-Base -o ./model.gguf -q Q6_K
HELP
}

main() {
    local positional=()

    while [ $# -gt 0 ]; do
        case "$1" in
            -o) OUTFILE="$2"; shift 2 ;;
            -q) QUANT_TYPE="$2"; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) echo "Unknown option: $1" >&2; exit 1 ;;
            *) positional+=("$1"); shift ;;
        esac
    done

    if [ ${#positional[@]} -eq 0 ]; then
        echo "Error: MODEL argument is required" >&2
        usage >&2
        exit 1
    fi

    local model="${positional[0]}"
    local model_name
    model_name=$(echo "$model" | sed 's|/$||; s|.*/||')

    ensure_llama_cpp
    ensure_venv

    model=$(resolve_model "$model")
    normalize_tokenizer_config "$model"

    if [ -z "$OUTFILE" ]; then
        mkdir -p "$SHARE_DIR/models"
        if [ -n "$QUANT_TYPE" ]; then
            OUTFILE="$SHARE_DIR/models/${model_name}-${QUANT_TYPE}.gguf"
        else
            OUTFILE="$SHARE_DIR/models/${model_name}-F16.gguf"
        fi
    fi

    echo "Converting $model to GGUF..." >&2
    "$VENV_DIR/bin/python3" "$LLAMA_CPP_DIR/convert_hf_to_gguf.py" \
        "$model" \
        --outfile "$OUTFILE" >&2

    if [ -n "$QUANT_TYPE" ]; then
        if ! command -v llama-quantize >/dev/null 2>&1; then
            echo "Warning: llama-quantize not found; skipping quantization" >&2
        else
            local quant_file="${OUTFILE%-F16.gguf}"
            if [ "$quant_file" = "$OUTFILE" ]; then
                quant_file="${OUTFILE%.gguf}"
            fi
            quant_file="${quant_file}-${QUANT_TYPE}.gguf"

            echo "Quantizing to $QUANT_TYPE..." >&2
            llama-quantize "$OUTFILE" "$quant_file" "$QUANT_TYPE" >&2
            rm "$OUTFILE"
            OUTFILE="$quant_file"
        fi
    fi

    echo "$OUTFILE"
}

main "$@"
